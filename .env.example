# ─── PerkPilot environment ────────────────────────────────────────────
# Copy to .env.local (Next.js) and .env (Prisma CLI). NEVER commit real keys.
# Every variable is optional: without them PerkPilot runs in demo mode.

# PostgreSQL (enables server-side persistence + rules database)
DATABASE_URL="postgresql://perkpilot:perkpilot@localhost:5432/perkpilot?schema=public"

# AI Concierge (server-side only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
PERKPILOT_LLM_MODEL=claude-opus-5-5

# Live data providers (Phase 3) — leave blank to use labelled demo data
DUFFEL_ACCESS_TOKEN=
# Live cash fares: "duffel" or "amadeus" (otherwise the demo flight model)
PERKPILOT_LIVE_FLIGHTS=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
# Set to "amadeus" for live Amadeus hotel rates
PERKPILOT_LIVE_HOTELS=
SEATS_AERO_API_KEY=
# Set to "seats-aero" to attach cached award availability
PERKPILOT_LIVE_AWARDS=
GOOGLE_PLACES_API_KEY=
# Set to "google-places" for live destination experiences
PERKPILOT_LIVE_EXPERIENCES=
UNSPLASH_ACCESS_KEY=

# Map tiles (public, rendered in the browser). Respect the tile provider's usage policy.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Rate limiting (requests per minute per client for AI + optimize endpoints)
RATE_LIMIT_PER_MINUTE=30

# Household sync between devices (self-hosted). Use a long random value (at least 32 characters).
PERKPILOT_SYNC_TOKEN=

# Admin rule-verification API (POST /api/admin/verify). At least 32 random characters.
PERKPILOT_ADMIN_TOKEN=

# ─── Abuse protection ─────────────────────────────────────────────────
# How many proxies sit in front of the app (Vercel or one nginx/Caddy = 1).
# Used to read the real client IP from X-Forwarded-For. 0 = exposed directly.
TRUSTED_PROXY_HOPS=1
# Max AI-concierge conversations that call the LLM per instance per UTC day.
# Beyond this the concierge answers in deterministic mode (no API cost).
CONCIERGE_DAILY_LIMIT=300
# Extra origins allowed to call the API from a browser (comma-separated), e.g. a staging domain.
ALLOWED_ORIGINS=
